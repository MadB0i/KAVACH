{
  "$comment": "Kavach Agent Security OS Layer - project-level Claude Code hook. Copy into .claude/settings.json and fill in YOUR paths (or let `kavach setup` do it).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|Read|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:/Kavach/adapters/claude/kavach-claude-hook.ps1\" -Policy \"C:/Kavach/config/privacy-starter.toml\" -FeedLog \"C:/Kavach/decisions.jsonl\""
          }
        ]
      }
    ]
  }
}
